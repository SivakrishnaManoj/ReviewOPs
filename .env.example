# Local development ONLY. Docker Compose supplies the database URL internally.
DATABASE_URL=postgresql://reviewops:local-development-only@localhost:5432/reviewops
APP_ENV=local
LOG_LEVEL=INFO
# Required for hosted AI endpoints. Never prefix secrets with VITE_.
DEMO_API_KEY=
AWS_REGION=eu-west-2
# Optional: enables paid Kimi investigations. Never commit a real key.
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_TIMEOUT_SECONDS=60
