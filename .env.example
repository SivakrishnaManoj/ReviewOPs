# Local development ONLY. Docker Compose supplies the database URL internally.
DATABASE_URL=postgresql://reviewops:local-development-only@localhost:5432/reviewops
APP_ENV=local
LOG_LEVEL=INFO
# Set a random value before exposing future paid AI endpoints. Never prefix secrets with VITE_.
DEMO_API_KEY=
AWS_REGION=eu-west-2
# Model identifiers and inference permissions are deliberately not enabled yet.
