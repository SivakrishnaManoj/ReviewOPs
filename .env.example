# Local development ONLY. Docker Compose supplies the database URL internally.
DATABASE_URL=postgresql://reviewops:local-development-only@localhost:5432/reviewops
APP_ENV=local
LOG_LEVEL=INFO
# Required for hosted AI endpoints. Never prefix secrets with VITE_.
DEMO_API_KEY=
AWS_REGION=eu-west-2
# Gemini is the default. Use a free-tier Google AI Studio project.
# Never commit a real key. Free quota depends on your Google project.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
# Optional paid provider: explicitly set LLM_PROVIDER=moonshot to use Kimi.
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3.1-pro
KIMI_TIMEOUT_SECONDS=60
